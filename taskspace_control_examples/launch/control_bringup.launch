<?xml version="1.0"?>
<launch>
  <!-- GDB functionality -->
  <arg name="debug" default="false" />
  <arg unless="$(arg debug)" name="launch_prefix" value=""/>
  <arg     if="$(arg debug)" name="launch_prefix" value="gdb --ex run --args"/>

  <!-- Load robot_description -->
  <param name="robot_description" command="xacro '$(find taskspace_control_examples)/urdf/robot6R.xacro'"/>

  <!-- Load hardware interface and controllers -->
  <rosparam file="$(find taskspace_control_examples)/config/robot_hardware.yaml"/>
  <rosparam file="$(find taskspace_control_examples)/config/example_controllers.yaml"/>

  <node name="sim_hw_interface" pkg="ros_control_boilerplate" type="sim_hw_main"
        output="screen" launch-prefix="$(arg launch_prefix)"/>
  <node name="default_controllers_spawner" pkg="controller_manager" type="controller_manager"
        respawn="false" output="screen" args="spawn joint_state_controller joint_trajectory_controller"/>
  <node name="taskspace_controller_spawner" pkg="controller_manager" type="controller_manager"
        respawn="false" output="screen" args="load pose_controller
                                                   as_nullspace_controller
                                                   as_twist_decomposition_controller"/>

  <!-- Published robot state -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

  <!-- Load rviz visualization -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find taskspace_control_examples)/config/taskspace_control_examples.rviz"/>

</launch>
